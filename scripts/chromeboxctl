#!/usr/bin/env bash
set -euo pipefail

HOST="${CHROMEBOX_HOST:-chromebox}"
SSH_CONNECT_TIMEOUT="${CHROMEBOX_SSH_CONNECT_TIMEOUT:-8}"
REMOTE_PATH='export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/bin'

usage() {
  cat <<'USAGE'
chromeboxctl - controlled helper for the ChromeOS host

Usage:
  scripts/chromeboxctl doctor
  scripts/chromeboxctl status
  scripts/chromeboxctl health
  scripts/chromeboxctl network
  scripts/chromeboxctl storage
  scripts/chromeboxctl hardware
  scripts/chromeboxctl devmode
  scripts/chromeboxctl vm
  scripts/chromeboxctl snapshot [--save]
  scripts/chromeboxctl restore-ssh

Environment:
  CHROMEBOX_HOST   SSH host alias to use. Default: chromebox
  CHROMEBOX_SSH_CONNECT_TIMEOUT
                   SSH connect timeout in seconds. Default: 8

Policy:
  Most commands are read-only. restore-ssh is the only write action in v0.
USAGE
}

remote() {
  ssh -o LogLevel=ERROR -o ConnectTimeout="$SSH_CONNECT_TIMEOUT" "$HOST" "$REMOTE_PATH; $*" 2> >(grep -v 'script from noexec mount' >&2)
}

ssh_config_value() {
  ssh -G "$HOST" 2>/dev/null | awk -v key="$1" '$1 == key {print $2; exit}'
}

section() {
  printf '\n## %s\n\n' "$1"
}

doctor() {
  section "Local Doctor"

  if command -v ssh >/dev/null 2>&1; then
    printf "PASS  %-22s %s\n" ssh "$(command -v ssh)"
  else
    printf "FAIL  %-22s %s\n" ssh "ssh command not found"
    return 1
  fi

  host_name="$(ssh_config_value hostname || true)"
  port="$(ssh_config_value port || true)"
  user="$(ssh_config_value user || true)"
  identity_file="$(ssh_config_value identityfile || true)"

  printf "INFO  %-22s %s\n" host-alias "$HOST"
  printf "INFO  %-22s %s\n" hostname "${host_name:-unknown}"
  printf "INFO  %-22s %s\n" port "${port:-22}"
  printf "INFO  %-22s %s\n" user "${user:-unknown}"
  printf "INFO  %-22s %s\n" identity "${identity_file:-default}"

  if [ -n "${identity_file:-}" ] && [ -f "${identity_file/#\~/$HOME}" ]; then
    printf "PASS  %-22s %s\n" identity-file exists
  elif [ -n "${identity_file:-}" ]; then
    printf "WARN  %-22s %s\n" identity-file "not found at ${identity_file}"
  else
    printf "WARN  %-22s %s\n" identity-file "not configured"
  fi

  if ssh -o BatchMode=yes -o ConnectTimeout="$SSH_CONNECT_TIMEOUT" -o LogLevel=ERROR "$HOST" 'true' 2>/tmp/chromeboxctl-doctor.err; then
    printf "PASS  %-22s %s\n" ssh-connect ok
  else
    err="$(tr '\n' ' ' </tmp/chromeboxctl-doctor.err | sed 's/[[:space:]]\+/ /g')"
    printf "FAIL  %-22s %s\n" ssh-connect "${err:-failed}"
    printf "\nRecovery hint:\n"
    printf "  1. Wake the Chromebox and confirm it is on the same LAN.\n"
    printf "  2. In the ChromeOS Developer Console, run:\n"
    printf "     sudo /usr/local/bin/restore-ssh\n"
    printf "  3. Retry: scripts/chromeboxctl doctor\n"
    return 1
  fi
}

status() {
  section "Identity"
  remote 'hostname; whoami; cat /etc/lsb-release | egrep "CHROMEOS_RELEASE_DESCRIPTION|CHROMEOS_RELEASE_VERSION|CHROMEOS_RELEASE_TRACK|CHROMEOS_RELEASE_BOARD|CHROMEOS_RELEASE_CHROME_MILESTONE"'
  section "Kernel"
  remote 'uname -a'
  section "Uptime"
  remote 'uptime'
  section "Memory"
  remote 'free -h'
}

health() {
  section "Health"
  remote '
    pass=0
    warn=0
    fail=0

    report() {
      state="$1"
      name="$2"
      detail="$3"
      printf "%-5s %-22s %s\n" "$state" "$name" "$detail"
      case "$state" in
        PASS) pass=$((pass + 1)) ;;
        WARN) warn=$((warn + 1)) ;;
        FAIL) fail=$((fail + 1)) ;;
      esac
    }

    release="$(. /etc/lsb-release 2>/dev/null; printf "%s" "${CHROMEOS_RELEASE_DESCRIPTION:-unknown}")"
    report PASS chromeos "$release"

    if crossystem devsw_cur 2>/dev/null | grep -qx 1; then
      report PASS devmode enabled
    else
      report WARN devmode "not enabled or unreadable"
    fi

    root_use="$(df -P / | awk "NR==2 {gsub(/%/, \"\", \$5); print \$5}")"
    stateful_use="$(df -P /mnt/stateful_partition | awk "NR==2 {gsub(/%/, \"\", \$5); print \$5}")"
    mem_avail_mb="$(free -m | awk "/^Mem:/ {print \$7}")"
    swap_used_mb="$(free -m | awk "/^Swap:/ {print \$3}")"

    if [ "${root_use:-100}" -lt 95 ]; then
      report PASS rootfs "${root_use}% used"
    else
      report WARN rootfs "${root_use}% used"
    fi

    if [ "${stateful_use:-100}" -lt 85 ]; then
      report PASS stateful "${stateful_use}% used"
    elif [ "${stateful_use:-100}" -lt 95 ]; then
      report WARN stateful "${stateful_use}% used"
    else
      report FAIL stateful "${stateful_use}% used"
    fi

    if [ "${mem_avail_mb:-0}" -gt 1024 ]; then
      report PASS memory "${mem_avail_mb}MB available"
    else
      report WARN memory "${mem_avail_mb}MB available"
    fi

    if [ "${swap_used_mb:-0}" -lt 1024 ]; then
      report PASS swap "${swap_used_mb}MB used"
    else
      report WARN swap "${swap_used_mb}MB used"
    fi

    if ip -br addr show wlan0 2>/dev/null | grep -q "UP .*192\\.168\\."; then
      report PASS wlan0 "$(ip -br addr show wlan0 | awk "{print \$3}")"
    else
      report WARN wlan0 "not up or no LAN IPv4"
    fi

    if ip -br addr 2>/dev/null | grep -q "^vmtap"; then
      report PASS crostini-net "$(ip -br addr | awk "/^vmtap/ {print \$3; exit}")"
    else
      report WARN crostini-net "vmtap interface not found"
    fi

    if ps aux | grep -v grep | grep -q "crosvm .*VM(33)"; then
      report PASS crosvm running
    else
      report WARN crosvm "termina VM not detected"
    fi

    if netstat -ltn 2>/dev/null | grep -q ":2223 "; then
      report PASS sshd "listening on 2223"
    else
      report WARN sshd "2223 not listening"
    fi

    printf "\nSummary: PASS=%s WARN=%s FAIL=%s\n" "$pass" "$warn" "$fail"
    [ "$fail" -eq 0 ]
  '
}

network() {
  section "Addresses"
  remote 'ip -br addr'
  section "Routes"
  remote 'ip route'
  section "Listeners"
  remote 'sudo netstat -ltnp 2>/dev/null | egrep "(:22|:2223|:8889|LISTEN)" || netstat -ltn 2>/dev/null | head -80'
}

storage() {
  section "Block Devices"
  remote 'lsblk'
  section "Filesystems"
  remote 'df -h'
  section "Important Mounts"
  remote 'mount | egrep " / |/mnt/stateful_partition|/usr/local|/home/chronos|crostini|encstateful"'
}

hardware() {
  section "CPU"
  remote 'cat /proc/cpuinfo | egrep "model name|cpu cores|siblings|vmx" | head -20'
  section "PCI"
  remote 'lspci 2>/dev/null | head -120'
  section "USB"
  remote 'lsusb 2>/dev/null || true'
}

devmode() {
  section "Crossystem"
  remote 'crossystem 2>/dev/null | egrep "devsw|mainfw|fwid|hwid|wpsw|block_devmode|recoverysw|kernkey_vfy|rootdev|dev_boot" || true'
}

vm() {
  section "Crostini Processes"
  remote 'ps aux | awk '\''/crosvm|vsh|termina|penguin|vm_concierge|seneschal|garcon/ && !/awk/ {cmd=$11; for (i=12; i<=NF && i<=16; i++) cmd=cmd " " $i; printf "%-12s %-7s %-5s %-5s %s\n", $1, $2, $3, $4, cmd}'\'' || true'
  section "VM Network"
  remote 'ip -br addr | egrep "vmtap|wlan|eth|lo"; ip route | egrep "100\\.115|default" || true'
}

snapshot() {
  section "Snapshot Time"
  date -u '+%Y-%m-%dT%H:%M:%SZ'
  status
  health
  network
  storage
  hardware
  devmode
  vm
}

save_snapshot() {
  mkdir -p snapshots
  file="snapshots/$(date +%Y%m%d-%H%M%S)-chromebox.md"
  snapshot > "$file"
  printf "%s\n" "$file"
}

restore_ssh() {
  ssh -tt -o LogLevel=ERROR -o ConnectTimeout="$SSH_CONNECT_TIMEOUT" "$HOST" "$REMOTE_PATH; sudo /usr/local/bin/restore-ssh" 2> >(grep -v 'script from noexec mount' >&2)
}

cmd="${1:-}"
case "$cmd" in
  doctor) doctor ;;
  status) status ;;
  health) health ;;
  network) network ;;
  storage) storage ;;
  hardware) hardware ;;
  devmode) devmode ;;
  vm) vm ;;
  snapshot)
    case "${2:-}" in
      --save) save_snapshot ;;
      "" ) snapshot ;;
      *)
        echo "Unknown snapshot option: $2" >&2
        exit 2
        ;;
    esac
    ;;
  restore-ssh) restore_ssh ;;
  -h|--help|help|"") usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
